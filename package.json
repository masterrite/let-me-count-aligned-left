{
  "name": "let-me-count-in-left-corner",
  "displayName": "Let me count (in left corner)",
  "description": "Your friendly companion that counts words and characters, supporting multiple languages, aligned to the left in the status bar. Fork from KrabsWong/let-me-count",
  "version": "1.0.3",
  "publisher": "Masterrite",
  "author": {
    "name": "KrabsWong"
  },
